    {
      "id": 15,
      "type": "timeseries",
      "title": "Pollers by task queue",
      "description": "Long polls open against each queue. Covers every queue: the demo workers report `payouts`, the server's internal workers report the temporal_sys_* queues. With poller autoscaling this rises under backlog and falls back to the minimum when idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "payout-demo-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
