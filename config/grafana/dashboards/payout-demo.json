    {
      "id": 6,
      "type": "timeseries",
      "title": "Payout business outcomes",
      "description": "Live counts by businessStatus from a Temporal visibility query over the custom search attribute. Aggregated with max across worker instances, which all report the same numbers.",
      "datasource": {
        "type": "prometheus",
        "uid": "payout-demo-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "payout-demo-prom"
          },
          "editorMode": "code",
          "refId": "A",
          "range": true,
          "expr": "max by (businessStatus) (payout_current_status)",
          "legendFormat": "{{businessStatus}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "payout-demo-prom"
          },
          "editorMode": "code",
          "refId": "B",
          "range": true,
          "expr": "sum(payout_workflows_started_total)",
          "legendFormat": "started (cumulative)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
