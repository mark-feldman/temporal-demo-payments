{
  "uid": "payout-demo",
  "title": "Payout demo \u2014 worker & server",
  "description": "SDK metrics from the Kotlin worker and cluster metrics from the Temporal server.",
  "tags": [
    "temporal",
    "payouts"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Focused \u2014 worker health and payout outcomes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Activity failures",
      "description": "Activity execution failures, including the retried attempts in the transient-failure scenario.",
      "datasource": {
        "type": "prometheus",
        "uid": "payout-demo-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "payout-demo-prom"
          },
          "editorMode": "code",
          "expr": "sum by (activity_type) (rate(temporal_activity_execution_failed_total{job=\"payout-demo-worker\"}[1m]))",
          "legendFormat": "{{activity_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Activity schedule-to-start",
      "description": "Worker backlog. Climbs when the worker cannot keep up with the load.",
      "datasource": {
        "type": "prometheus",
        "uid": "payout-demo-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "payout-demo-prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(temporal_activity_schedule_to_start_latency_seconds_bucket{job=\"payout-demo-worker\"}[1m])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Workflow task schedule-to-start",
      "description": "The clearest worker-saturation signal. NOTE: the SDK histogram tops out at a 30s bucket, so p95 pinned at exactly 30 means \"above 30s, cannot say how far\" -- read the max series and the backlog panels below for the real number.",
      "datasource": {
        "type": "prometheus",
        "uid": "payout-demo-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "payout-demo-prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(temporal_workflow_task_schedule_to_start_latency_seconds_bucket{job=\"payout-demo-worker\"}[1m])))",
          "legendFormat": "p95 (clamps at 30s)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "payout-demo-prom"
          },
          "editorMode": "code",
          "expr": "max(temporal_workflow_task_schedule_to_start_latency_seconds_max{job=\"payout-demo-worker\"})",
          "legendFormat": "max (unclamped)",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Worker task slots available",
      "description": "Remaining capacity per worker instance. Running `make workers N=2` adds two more series here.",
      "datasource": {
        "type": "prometheus",
        "uid": "payout-demo-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "payout-demo-prom"
          },
          "editorMode": "code",
          "refId": "A",
          "range": true,
          "expr": "sum by (instance, worker_type) (temporal_worker_task_slots_available{job=\"payout-demo-worker\",worker_type=~\"ActivityWorker|WorkflowWorker\"})",
          "legendFormat": "{{instance}} {{worker_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
