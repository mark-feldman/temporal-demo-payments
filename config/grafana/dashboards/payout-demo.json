    {
      "id": 12,
      "type": "stat",
      "title": "Live worker instances",
      "description": "Worker JVMs currently scraping, the API excluded (role=\"worker\"). Counts every port in the scrape list, so scaling past three is visible.",
      "datasource": {
        "type": "prometheus",
        "uid": "payout-demo-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "payout-demo-prom"
          },
          "editorMode": "code",
          "refId": "A",
          "range": true,
          "expr": "count(count by (instance) (up{job=\"payout-demo-worker\",role=\"worker\"} == 1))",
          "legendFormat": "workers"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value"
      }
    },
