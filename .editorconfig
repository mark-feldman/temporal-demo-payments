# Keeps an editor's formatting in step with the code that is already here. Without it an IDE on
# the Kotlin official preset reformats on save and produces diffs nobody asked for.
#
# Verified against this repo's IDE by reformatting a probe file: indent and continuation indent
# are honoured, and trailing commas are restored on wrapped argument lists (this codebase has
# 206 of them against 2 without).
#
# Not covered: a blank line inserted between `when` branches with bodies. The IDE keeps doing
# that with ij_kotlin_blank_lines_around_block_when_branches set, so it has to come from
# Settings > Editor > Code Style > Kotlin > Blank Lines > Around 'when' branches with {}.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ij_continuation_indent_size = 4
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{js,json,yml,yaml,css,html}]
indent_size = 2

[Makefile]
indent_style = tab

# Generated by Gradle, and a batch file keeps its CRLF endings.
[gradlew.bat]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
